# Copy to .env and replace the placeholder values. Shared by docker-compose and the API.

# Postgres (docker-compose)
POSTGRES_USER=cardtable
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cardtable
# The API runs on the host. Use 127.0.0.1, not localhost: on Windows "localhost" tries ::1 first,
# and the containers only listen on IPv4, which adds ~2 s to every new connection.
# Production (Neon): paste the direct (non-pooled) connection string as Neon shows it, e.g.
#   postgresql://<user>:<password>@ep-<name>.eu-central-1.aws.neon.tech/<db>?sslmode=require&channel_binding=require
# The app converts it for asyncpg (driver, and sslmode -> ssl).
DATABASE_URL=postgresql+asyncpg://cardtable:change-me@127.0.0.1:5432/cardtable

# Redis. REDIS_PASSWORD is for the docker-compose Redis (--requirepass). It is optional for the API
# when the password is in REDIS_URL, as with Upstash in production:
#   rediss://default:<password>@<name>.upstash.io:6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://127.0.0.1:6379/0

# Cloudflare R2 (S3-compatible API). Create an R2 API token with Object Read & Write on the bucket.
# Endpoint: https://<account_id>.r2.cloudflarestorage.com (EU jurisdiction: <account_id>.eu.r2...)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=card-art
# Public URL of the bucket (a custom domain or https://pub-<hash>.r2.dev). Card and origin art is
# loaded from here. The bucket also needs a CORS rule allowing PUT and GET from the app origin.
R2_PUBLIC_BASE_URL=https://pub-change-me.r2.dev
# Art uploads: at most 2 MiB, and presigned upload URLs stay valid for 5 minutes.
UPLOAD_MAX_BYTES=2097152
UPLOAD_URL_TTL_S=300
# The art sweep deletes art that no card or origin references: at most once per interval, only
# objects older than the grace period, and nothing at all when more than MAX_DELETES would go.
# Keep it off here. Turn it on only where the database and the bucket belong together
# (production does, in render.yaml); with a mismatched pair every object would look unused.
# Manual runs: python -m scripts.sweep_art (a dry run unless --delete).
ART_SWEEP_ENABLED=false
ART_SWEEP_INTERVAL_H=24
ART_SWEEP_GRACE_H=24
ART_SWEEP_MAX_DELETES=200

# Auth. JWT_SECRET must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# The refresh token is an HttpOnly cookie. Browsers accept Secure cookies on http://localhost, so
# keep this true; set false only to open the app over plain HTTP on another host (e.g. a LAN IP).
REFRESH_COOKIE_SECURE=true

# Seconds each dependency check in GET /api/health may take.
HEALTH_CHECK_TIMEOUT_S=2.0

# Logging. LOG_LEVEL (DEBUG, INFO, WARNING or ERROR) applies to the app's own loggers only;
# DEBUG adds health probes, static files and the steps of long flows. LOG_FORMAT is auto (coloured
# lines in a terminal, JSON otherwise), console or json. Render sets json.
LOG_LEVEL=INFO
LOG_FORMAT=auto

# Production image only (the Dockerfile sets it): the API serves the built frontend from here.
# Leave it unset in development, where nginx sends page requests to the Vite dev server.
# FRONTEND_DIST_DIR=/srv/frontend/dist
